# Copy this file to ".env" and fill in your values.  ".env" is git-ignored.
# Supabase credentials are required. YouTube search is optional.

# --- Supabase Free project (server-only credentials; never use NEXT_PUBLIC_ here) ---
SUPABASE_URL=https://ftudnppncyxjkdflqosu.supabase.co
SUPABASE_SERVICE_ROLE_KEY= eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ0dWRucHBuY3l4amtkZmxxb3N1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjA2NTA0NywiZXhwIjoyMTA3NjQxMDQ3fQ.TbxRYAa8uThKblp_aFQl621C1lL5UoYZpsOfV9KJH-g

# --- YouTube Data API v3 key (free quota; see README "YouTube API key") ---
# The key stays on the server. It is never sent to browsers.
YOUTUBE_API_KEY= AIzaSyAICCKgcXskemf73OEoy1ASakO43cO4mJc

# Extra local soft limit for search.list calls per UTC day. This does not represent
# Google's actual quota. Check your project's Cloud Console. Set 0 to disable the guard.
YOUTUBE_DAILY_SEARCH_LIMIT=100

# How long a cached search result is considered fresh (hours). Cached results are
# used when YouTube search is unavailable; Supabase must still be reachable.
SEARCH_CACHE_TTL_HOURS=168

# --- Server ---
PORT=3000
# Address to bind. 0.0.0.0 lets phones on your Wi-Fi connect.
HOST=0.0.0.0

# Force the address put in QR codes (e.g. 192.168.1.100) if auto-detection picks the
# wrong network adapter. Never use localhost here: phones cannot reach it.
LAN_HOST=

# --- Security ---
# By default only the computer running the server (localhost) can create sessions.
# Set a PIN to also allow creating sessions from another device on your LAN.
HOST_PIN=
# Requests from non-private (internet) IP addresses are refused unless this is "true".
ALLOW_PUBLIC_ACCESS=false

# --- Queue rules ---
MAX_PENDING_PER_GUEST=5
MAX_QUEUE_SIZE=200

