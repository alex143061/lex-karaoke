{
  "name": "lex-karaoke",
  "version": "1.0.0",
  "private": true,
  "description": "Local-network QR karaoke app (Next.js + Socket.IO + Supabase + YouTube)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts --dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "serve": "node --env-file-if-exists=.env --import tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "postcss": "^8.5.30",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
